{
    "name": "magelens/pcov",
    "type": "php-ext",
    "license": "PHP-3.01",
    "description": "PCOV fork for PHP line coverage with synchronous native export and executable-line manifest reuse for large test suites",
    "keywords": ["php", "pcov", "code-coverage", "phpunit", "testing", "php-extension", "magento2"],
    "homepage": "https://magelens.dev/",
    "authors": [
        {
            "name": "MageLens",
            "email": "hello@magelens.dev",
            "homepage": "https://magelens.dev/",
            "role": "Fork maintainer"
        }
    ],
    "support": {
        "email": "hello@magelens.dev",
        "issues": "https://github.com/MageLens/pcov/issues",
        "source": "https://github.com/MageLens/pcov",
        "docs": "https://github.com/MageLens/pcov#readme"
    },
    "require": {
        "php": ">=8.3 <8.7"
    },
    "conflict": {
        "pecl/pcov": "*"
    },
    "php-ext": {
        "extension-name": "pcov",
        "support-zts": false,
        "support-nts": true,
        "os-families": ["linux"],
        "configure-options": [
            {
                "name": "enable-pcov",
                "description": "Enable php coverage support"
            }
        ]
    }
}
